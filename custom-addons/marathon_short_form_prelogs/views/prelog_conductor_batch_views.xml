<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mv_prelog_conductor_recipient_list" model="ir.ui.view">
        <field name="name">mv.prelog.conductor.recipient.list</field>
        <field name="model">mv.prelog.conductor.recipient</field>
        <field name="arch" type="xml">
            <list string="Prelog Recipients" js_class="prelog_recipient_list" multi_edit="1" create="false" delete="false" limit="1000">
                <header>
                    <button name="action_send_selected" string="Send Selected" type="object" class="btn-primary"/>
                    <button name="action_retry_generation" string="Retry Generation" type="object"/>
                    <button name="action_regenerate" string="Regenerate" type="object"/>
                </header>
                <field name="included" widget="prelog_include_checkbox" readonly="not email or status in ('queued', 'sent')"/>
                <field name="contact_id"/>
                <field name="account_id" optional="show"/>
                <field name="email"/>
                <field name="email_cc" optional="show"/>
                <field name="prelog_count"/>
                <field name="is_resend" optional="show"/>
                <field name="attachment_filename" string="Attachment"/>
                <button name="action_download_attachment" type="object" icon="fa-download" title="Download workbook" invisible="not attachment_id"/>
                <field name="status" widget="badge" decoration-info="status in ('pending', 'processing')" decoration-success="status in ('prepared', 'sent')" decoration-warning="status in ('missing_email', 'duplicate', 'queued')" decoration-danger="status == 'failed'"/>
                <field name="error_message"/>
                <field name="attachment_id" column_invisible="True"/>
                <field name="batch_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mv_prelog_conductor_recipient_form" model="ir.ui.view">
        <field name="name">mv.prelog.conductor.recipient.form</field>
        <field name="model">mv.prelog.conductor.recipient</field>
        <field name="arch" type="xml">
            <form string="Prepared Prelog Email" create="false" delete="false">
                <header>
                    <button name="action_send_selected" string="Send" type="object" class="btn-primary" invisible="status != 'prepared' or not included"/>
                    <button name="action_retry_generation" string="Retry Generation" type="object" invisible="status != 'failed'"/>
                    <button name="action_regenerate" string="Regenerate" type="object" invisible="status in ('processing', 'queued')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_download_attachment" type="object" class="oe_stat_button" icon="fa-download" invisible="not attachment_id">
                            <div class="o_stat_info"><span class="o_stat_text">Download Workbook</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="contact_id" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                            <field name="network_id" readonly="1"/>
                            <field name="week" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="prelog_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="included" readonly="status not in ('prepared', 'missing_email', 'failed', 'duplicate')"/>
                            <field name="account_id" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="email_cc" readonly="1"/>
                            <field name="attachment_filename" readonly="1"/>
                            <field name="mail_id" readonly="1" invisible="not mail_id"/>
                        </group>
                    </group>
                    <group string="Prepared Email">
                        <field name="email_subject" readonly="1"/>
                        <field name="email_body" readonly="1" widget="html"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                    <field name="attachment_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mv_prelog_conductor_recipient_search" model="ir.ui.view">
        <field name="name">mv.prelog.conductor.recipient.search</field>
        <field name="model">mv.prelog.conductor.recipient</field>
        <field name="arch" type="xml">
            <search string="Prelog Recipients">
                <field name="contact_id"/>
                <field name="account_id"/>
                <field name="email"/>
                <field name="network_id"/>
                <field name="week"/>
                <field name="version"/>
                <filter name="prepared" string="Prepared" domain="[('status', '=', 'prepared')]"/>
                <filter name="missing_email" string="Missing Email" domain="[('status', '=', 'missing_email')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_contact" string="Contact" context="{'group_by': 'contact_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mv_prelog_conductor_recipient" model="ir.actions.act_window">
        <field name="name">Prelog Recipients</field>
        <field name="res_model">mv.prelog.conductor.recipient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mv_prelog_conductor_recipient_search"/>
    </record>

    <record id="view_mv_prelog_conductor_batch_list" model="ir.ui.view">
        <field name="name">mv.prelog.conductor.batch.list</field>
        <field name="model">mv.prelog.conductor.batch</field>
        <field name="arch" type="xml">
            <list string="Prelog Batches" create="false" delete="false">
                <field name="name"/>
                <field name="network_id"/>
                <field name="week"/>
                <field name="version"/>
                <field name="recipient_count"/>
                <field name="prepared_count"/>
                <field name="missing_email_count"/>
                <field name="failed_count"/>
                <field name="state" widget="badge" decoration-info="state == 'preparing'" decoration-success="state in ('ready', 'sent')" decoration-warning="state == 'queued'" decoration-danger="state == 'attention'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_mv_prelog_conductor_batch_form" model="ir.ui.view">
        <field name="name">mv.prelog.conductor.batch.form</field>
        <field name="model">mv.prelog.conductor.batch</field>
        <field name="arch" type="xml">
            <form string="Prelog Batch" create="false" delete="false">
                <header>
                    <button name="action_send_all" string="Send All" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_recipients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="recipient_count" widget="statinfo" string="Recipients"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="network_id" readonly="1"/>
                            <field name="week" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="requested_by_id" readonly="1"/>
                        </group>
                        <group string="Summary">
                            <field name="prelog_count" readonly="1"/>
                            <field name="prepared_count" readonly="1"/>
                            <field name="missing_email_count" readonly="1"/>
                            <field name="failed_count" readonly="1"/>
                            <field name="queued_count" readonly="1"/>
                            <field name="sent_count" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Recipients"/>
                    <field name="recipient_ids" widget="prelog_recipient_x2many" nolabel="1" context="{'default_batch_id': id}">
                        <list multi_edit="1" create="false" delete="false" limit="1000">
                            <header>
                                <button name="action_send_selected" string="Send Selected" type="object" class="btn-primary"/>
                                <button name="action_retry_generation" string="Retry Generation" type="object"/>
                                <button name="action_regenerate" string="Regenerate" type="object"/>
                            </header>
                            <field name="included" widget="prelog_include_checkbox" readonly="not email or status in ('queued', 'sent')"/>
                            <field name="contact_id"/>
                            <field name="email"/>
                            <field name="email_cc" optional="show"/>
                            <field name="prelog_count"/>
                            <field name="is_resend" optional="show"/>
                            <field name="attachment_filename" string="Attachment"/>
                            <button name="action_download_attachment" type="object" icon="fa-download" title="Download workbook" invisible="not attachment_id"/>
                            <field name="status" widget="badge" decoration-info="status in ('pending', 'processing')" decoration-success="status in ('prepared', 'sent')" decoration-warning="status in ('missing_email', 'duplicate', 'queued')" decoration-danger="status == 'failed'"/>
                            <field name="error_message"/>
                            <field name="attachment_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mv_prelog_conductor_batch" model="ir.actions.act_window">
        <field name="name">Prelog Batches</field>
        <field name="res_model">mv.prelog.conductor.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
