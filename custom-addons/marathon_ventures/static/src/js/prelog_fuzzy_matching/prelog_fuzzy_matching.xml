<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="marathon_ventures.MvPrelogFuzzyMatching">
    <div class="mv-fuzzy">
      <main class="mv-fuzzy__main" t-if="state.loaded">
        <h1 class="mv-fuzzy__page-title">Prelog Workbench</h1>

        <section class="mv-fuzzy__upload-context" t-if="state.latestUpload and state.filters.importJobId">
          <i class="fa fa-user-circle"/>
          <div>
            <strong>Your latest completed upload</strong>
            <span><t t-esc="state.latestUpload.program_name"/> · Week <t t-esc="state.latestUpload.week_start"/> · Version <t t-esc="state.latestUpload.version"/> · <t t-esc="state.latestUpload.row_count"/> rows</span>
          </div>
        </section>

        <section class="mv-fuzzy__filter-card">
          <div class="mv-fuzzy__filter-grid">
            <label class="mv-fuzzy__field">
              <span>Program / Network <small>Optional</small></span>
              <select t-on-change="onProgramChange" t-att-disabled="state.querying or state.mutating">
                <option value="">All Programs</option>
                <option t-foreach="state.programs" t-as="program" t-key="program.id"
                        t-att-value="program.id" t-att-selected="program.id === state.filters.programId">
                  <t t-esc="program.name"/><t t-if="program.inactive"> (Inactive)</t>
                </option>
              </select>
            </label>
            <label class="mv-fuzzy__field">
              <span>Week <small>Optional · Monday</small></span>
              <input type="date" t-att-value="state.filters.weekStart"
                     t-on-change="onWeekChange" t-att-disabled="state.querying or state.mutating"/>
            </label>
            <label class="mv-fuzzy__field">
              <span>Version <small>Optional</small></span>
              <select t-on-change="onVersionChange"
                      t-att-disabled="state.querying or state.mutating">
                <option value="">All Versions</option>
                <option t-foreach="state.versions" t-as="version" t-key="version"
                        t-att-value="version" t-att-selected="version === state.filters.version">
                  Version <t t-esc="version"/>
                </option>
              </select>
            </label>
            <div class="mv-fuzzy__filter-actions">
              <button class="btn btn-primary" t-on-click="onFilter" t-att-disabled="state.querying or state.mutating or importInFlight">
                <i class="fa fa-filter me-1"/><t t-esc="state.querying ? 'Loading…' : 'View Prelogs'"/>
              </button>
              <button class="btn btn-outline-secondary" t-on-click="onExport"
                      t-att-disabled="state.exporting or state.querying or state.mutating or !state.hasFiltered or importInFlight">
                <i class="fa fa-download me-1"/><t t-esc="state.exporting ? 'Exporting…' : 'Export View'"/>
              </button>
              <button class="btn btn-outline-primary" t-on-click="onImport"
                      t-att-disabled="state.querying or state.mutating or importInFlight">
                <i class="fa fa-upload me-1"/>Import
              </button>
              <!-- <button class="btn btn-outline-warning"
                      title="Per-schedule breakdown: prelogs attached vs units available, with each schedule's rate / rotation / days so you can see why they matched"
                      t-on-click="onExportOverrunDiagnostics"
                      t-att-disabled="state.exporting or state.querying or state.mutating or !state.hasFiltered">
                <i class="fa fa-stethoscope me-1"/>Overrun Diagnostics
              </button> -->
            </div>
          </div>
        </section>

        <section class="mv-postlog-import-status" t-if="state.importJob">
          <i class="fa fa-spinner fa-spin"/>
          <span><strong t-esc="state.importJob.state === 'completed' ? 'Import finished — loading rows…' : 'Import running…'"/>
            <t t-if="state.importJob.total_row_count"> <t t-esc="state.importJob.total_row_count"/> row(s)</t>
            <span class="mv-postlog-import-status__state" t-esc="state.importJob.state"/>
          </span>
        </section>

        <section class="mv-postlog-import-wait" t-if="importInFlight">
          <i class="fa fa-hourglass-half"/>
          <h2>Waiting for the import to finish</h2>
          <p>The previous view is hidden so it cannot be mistaken for this
             upload's result. Rows load automatically when the job completes.</p>
        </section>

        <section class="mv-fuzzy__results" t-if="state.hasFiltered and !importInFlight">
          <nav class="mv-fuzzy__tabs" aria-label="Prelog status">
            <button t-att-class="state.activeTab === 'all' ? 'active' : ''" t-on-click="() => this.setTab('all')">All <span t-esc="state.counts.all"/></button>
            <button t-att-class="state.activeTab === 'matched' ? 'active' : ''" t-on-click="() => this.setTab('matched')">Matched <span t-esc="state.counts.matched"/></button>
            <button t-att-class="state.activeTab === 'unmatched' ? 'active' : ''" t-on-click="() => this.setTab('unmatched')">Unmatched <span t-esc="state.counts.unmatched"/></button>
            <button t-att-class="state.activeTab === 'suggestions' ? 'active' : ''" t-on-click="() => this.setTab('suggestions')">Suggestions <span t-esc="state.counts.suggestions"/></button>
            <button t-att-class="state.activeTab === 'no_suggestion' ? 'active' : ''" t-on-click="() => this.setTab('no_suggestion')">No Suggestion <span t-esc="state.counts.no_suggestion"/></button>
            <button t-att-class="state.activeTab === 'removed' ? 'active' : ''" t-on-click="() => this.setTab('removed')">Removed <span t-esc="state.counts.removed"/></button>
            <button t-att-class="state.activeTab === 'overruns' ? 'active' : ''" t-on-click="() => this.setTab('overruns')">Overruns <span t-esc="state.counts.overruns"/></button>

            <!-- Total Dollars for the current view. Server-computed over
                 the whole scope, so it is NOT limited to the visible
                 page. When a single upload is in view it also reconciles
                 against the file's own total. -->
            <div class="mv-fuzzy__dollars" t-att-class="dollarsReconcileClass"
                 t-att-title="totalDollarsTitle">
              <span class="mv-fuzzy__dollars-label">Total Dollars:</span>
              <span class="mv-fuzzy__dollars-value" t-esc="totalDollarsLabel"/>
              <t t-if="state.dollarsAvailable and dollarsReconcile">
                <i t-if="dollarsReconcile.matches"
                   class="fa fa-check-circle mv-fuzzy__dollars-icon"/>
                <i t-else="" class="fa fa-exclamation-triangle mv-fuzzy__dollars-icon"/>
              </t>
            </div>
          </nav>

          <!-- Reconciliation detail, only when the processed total does
               not equal the uploaded file's total. -->
          <div class="mv-fuzzy__dollars-note" t-if="state.dollarsAvailable and dollarsReconcile and !dollarsReconcile.matches">
            <i class="fa fa-exclamation-triangle me-1"/>
            <t t-if="dollarsReconcile.explained">
              Uploaded file totalled <strong t-esc="dollarsReconcile.uploadedLabel"/>,
              processed <strong t-esc="dollarsReconcile.processedLabel"/>
              (<t t-esc="dollarsReconcile.diffLabel"/>) —
              <t t-esc="dollarsReconcile.errors"/> row(s) failed to import.
            </t>
            <t t-else="">
              Processed <strong t-esc="dollarsReconcile.processedLabel"/> but the
              uploaded file totalled <strong t-esc="dollarsReconcile.uploadedLabel"/>
              (<t t-esc="dollarsReconcile.diffLabel"/>). No rows errored, so this
              gap needs investigating.
            </t>
          </div>

          <div class="mv-fuzzy__searchbar">
            <label class="mv-fuzzy__search">
              <i class="fa fa-search"/>
              <input type="search" placeholder="Search prelog, adv/product, deal or schedule"
                     t-att-value="state.searchTerm"
                     t-on-input="(ev) => this.state.searchTerm = ev.target.value"
                     t-on-keydown="onSearchKeydown"/>
            </label>
            <input class="mv-fuzzy__compact-input" type="date" title="Air date"
                   t-att-value="state.airDate" t-on-change="(ev) => this.state.airDate = ev.target.value"/>
            <select class="mv-fuzzy__compact-input" t-on-change="(ev) => this.state.issueFilter = ev.target.value">
              <option value="">All issues</option><option value="time">Time issue</option>
              <option value="length">Length issue</option><option value="ambiguous">Tied schedules</option>
              <option value="missing_deal">Missing deal #</option>
            </select>
            <button class="btn btn-outline-primary btn-sm" t-on-click="onFilter" t-att-disabled="state.querying">Apply</button>
          </div>

          <div class="mv-fuzzy__results-toolbar">
            <div>
              <h2 t-esc="tabTitle()"/>
              <p t-if="state.total">Showing <t t-esc="visibleRangeStart"/>–<t t-esc="visibleRangeEnd"/> of <t t-esc="state.total"/></p>
              <p t-else="">No rows in this view.</p>
            </div>
            <div class="mv-fuzzy__bulk-actions">
              <button class="btn btn-outline-secondary btn-sm" t-on-click="onRefresh"
                      t-if="state.activeTab !== 'matched' and state.activeTab !== 'removed'"
                      t-att-disabled="state.refreshing or state.querying or state.mutating"
                      title="Re-check unmatched rows against the current Schedules">
                <i class="fa fa-refresh me-1" t-att-class="state.refreshing ? 'fa-spin' : ''"/><t t-esc="state.refreshing ? 'Re-checking…' : 'Refresh'"/>
              </button>
              <span t-if="selectedCount"><strong t-esc="selectedCount"/> selected</span>
              <button class="btn btn-success btn-sm" t-on-click="attachSuggested"
                      t-if="state.activeTab === 'all' or state.activeTab === 'unmatched' or state.activeTab === 'suggestions'"
                      t-att-disabled="!selectedCount or state.mutating">Attach Suggested</button>
              <button class="btn btn-outline-danger btn-sm" t-on-click="() => this.setRemoved(true)"
                      t-if="state.activeTab !== 'removed'" t-att-disabled="!selectedCount or state.mutating">
                <i class="fa fa-ban me-1"/>Remove
              </button>
              <button class="btn btn-outline-success btn-sm" t-on-click="() => this.setRemoved(false)"
                      t-if="state.activeTab === 'removed'" t-att-disabled="!selectedCount or state.mutating">
                <i class="fa fa-undo me-1"/>Unremove
              </button>
              <button class="btn btn-danger btn-sm" t-on-click="() => this.deleteSelected()"
                      t-att-disabled="!selectedCount or state.mutating">
                <i class="fa fa-trash me-1"/>Delete
              </button>
            </div>
          </div>

          <div class="mv-fuzzy__select-all" t-if="canSelectAllMatching">
            All <strong t-esc="state.rows.length"/> rows on this page are selected.
            <button type="button" t-on-click="selectEveryMatchingRow">
              Select all <t t-esc="state.total"/> matching rows
            </button>
          </div>
          <div class="mv-fuzzy__select-all" t-if="state.selectAllMatching and selectedCount">
            All <strong t-esc="selectedCount"/> matching rows are selected.
            <button type="button" t-on-click="clearSelection">Clear selection</button>
          </div>

          <div class="mv-fuzzy__loading" t-if="state.querying"><i class="fa fa-spinner fa-spin"/> Loading Prelog rows…</div>
          <div class="mv-fuzzy__empty" t-if="!state.querying and !state.total">
            <i class="fa fa-inbox"/><h3>No Prelogs here</h3><p>Try another status tab or adjust the filters.</p>
          </div>

          <div class="mv-fuzzy__table-wrap" t-if="!state.querying and state.rows.length">
            <table class="mv-fuzzy__table mv-fuzzy__table--workbench">
              <thead><tr>
                <th class="mv-fuzzy__check"><input type="checkbox" t-att-checked="allPageSelected" t-on-change="toggleAll"/></th>
                <th t-att-aria-sort="sortAria('status')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('status')"><span>Status</span><i t-att-class="sortIcon('status')"/></button></th>
                <th t-att-aria-sort="sortAria('name')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('name')"><span>Prelog</span><i t-att-class="sortIcon('name')"/></button></th>
                <th t-att-aria-sort="sortAria('schedule')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('schedule')"><span>Schedule</span><i t-att-class="sortIcon('schedule')"/></button></th>
                <th t-att-aria-sort="sortAria('network')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('network')"><span>Network</span><i t-att-class="sortIcon('network')"/></button></th>
                <th t-att-aria-sort="sortAria('air_date')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('air_date')"><span>Air Date / Time</span><i t-att-class="sortIcon('air_date')"/></button></th>
                <th t-att-aria-sort="sortAria('length')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('length')"><span>Length</span><i t-att-class="sortIcon('length')"/></button></th>
                <th t-att-aria-sort="sortAria('rate')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('rate')"><span>Rate</span><i t-att-class="sortIcon('rate')"/></button></th>
                <th t-att-aria-sort="sortAria('deal_number')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('deal_number')"><span>Network Deal #</span><i t-att-class="sortIcon('deal_number')"/></button></th>
                <th t-att-aria-sort="sortAria('advertiser_product')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('advertiser_product')"><span>Adv / Product</span><i t-att-class="sortIcon('advertiser_product')"/></button></th>
                <th t-att-aria-sort="sortAria('info')"><button type="button" class="mv-fuzzy__sort-button" t-on-click="() => this.onSort('info')"><span>Info</span><i t-att-class="sortIcon('info')"/></button></th>
                <th>Details</th>
              </tr></thead>
              <tbody>
                <tr t-foreach="state.rows" t-as="row" t-key="row.id" t-att-class="isSelected(row) ? 'is-selected' : ''">
                  <td class="mv-fuzzy__check"><input type="checkbox" t-att-checked="isSelected(row)" t-on-change="(ev) => this.toggleRow(row, ev)"/></td>
                  <td><span t-att-class="statusBadge(row)" t-esc="row.status_label"/></td>
                  <!-- Prelog name opens the full record in a NEW tab.
                       The review drawer is still one click away via the
                       Review button in the Details column, so no
                       behaviour is lost. -->
                  <td><a class="mv-fuzzy__record-link" target="_blank" rel="noopener"
                         t-att-href="prelogOpenUrl(row)"
                         t-on-click.stop="() => {}" t-esc="row.name"/></td>
                  <!-- A suggestion is not an attachment. Keep this column blank
                       until the Prelog really belongs to a Schedule. -->
                  <td>
                    <a t-if="row.attached" class="mv-fuzzy__record-link" target="_blank" rel="noopener"
                       t-att-href="scheduleOpenUrl(row.attached)"
                       t-on-click.stop="() => {}" t-esc="row.attached.name"/>
                  </td>
                  <td t-esc="row.network"/>
                  <td><t t-esc="row.air_date"/> <span class="mv-fuzzy__muted"><t t-esc="row.day"/> · <t t-esc="row.air_time"/></span></td>
                  <td t-att-class="row.length_mismatch ? 'mv-fuzzy__text-warning' : ''" t-esc="row.length"/>
                  <td t-att-class="row.rate_mismatch ? 'mv-fuzzy__text-warning' : ''">$<t t-esc="formatRate(row.rate)"/></td>
                  <td t-esc="row.deal_number"/>
                  <td><span class="mv-fuzzy__advertiser-product" t-att-title="row.advertiser_product" t-esc="row.advertiser_product"/></td>
                  <td><span class="mv-fuzzy__reason" t-att-title="row.info" t-esc="row.info"/></td>
                  <td><button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.openDrawer(row)"><i class="fa fa-eye"/> Review</button></td>
                </tr>
              </tbody>
            </table>
          </div>

          <nav class="mv-fuzzy__pager" t-if="state.total">
            <button class="btn btn-outline-secondary btn-sm" t-on-click="previousPage" t-att-disabled="state.offset &lt;= 0 or state.querying"><i class="fa fa-chevron-left"/> Previous</button>
            <span>Page <strong t-esc="state.page"/> of <strong t-esc="state.pages"/></span>
            <button class="btn btn-outline-secondary btn-sm" t-on-click="nextPage" t-att-disabled="state.offset + state.pageSize &gt;= state.total or state.querying">Next <i class="fa fa-chevron-right"/></button>
          </nav>
        </section>

        <section class="mv-fuzzy__welcome" t-if="!state.hasFiltered and !importInFlight">
          <i class="fa fa-table"/><h2>Choose a Prelog set to begin</h2><p>Your newest completed upload is selected automatically when available. All parameters remain editable.</p>
        </section>
      </main>

      <div class="mv-fuzzy__drawer-backdrop" t-if="state.drawerRow" t-on-click="closeDrawer"/>
      <aside class="mv-fuzzy__drawer" t-if="state.drawerRow">
        <header>
          <div><span t-att-class="statusBadge(state.drawerRow)" t-esc="state.drawerRow.status_label"/><h2 t-esc="state.drawerRow.name"/></div>
          <button class="btn btn-light btn-sm" t-on-click="closeDrawer"><i class="fa fa-times"/></button>
        </header>
        <div class="mv-fuzzy__drawer-body">
          <section><h3>Prelog Data</h3><dl class="mv-fuzzy__details">
            <dt>Network</dt><dd t-esc="state.drawerRow.network"/><dt>Air date</dt><dd><t t-esc="state.drawerRow.air_date"/> · <t t-esc="state.drawerRow.air_time"/></dd>
            <dt>Deal #</dt><dd t-esc="state.drawerRow.deal_number"/><dt>Adv / Product</dt><dd t-esc="state.drawerRow.advertiser_product"/>
            <dt>Agency</dt><dd t-esc="state.drawerRow.agency or '—'"/><dt>Length / Rate</dt><dd><t t-esc="state.drawerRow.length"/> · $<t t-esc="formatRate(state.drawerRow.rate)"/></dd>
          </dl></section>

          <section t-if="state.drawerRow.attached">
            <h3>Attached Schedule</h3>
            <t t-set="schedule" t-value="state.drawerRow.attached"/>
            <dl class="mv-fuzzy__details"><dt>Name</dt><dd><a class="mv-fuzzy__record-link"
              target="_blank" rel="noopener" t-att-href="scheduleOpenUrl(schedule)"
              t-on-click.stop="() => {}" t-esc="schedule.name"/></dd>
              <dt>Rotation</dt><dd t-esc="schedule.time_range or '—'"/><dt>Days</dt><dd t-esc="schedule.days_allowed or '—'"/>
              <dt>Length / Rate</dt><dd><t t-esc="schedule.length"/> · $<t t-esc="formatRate(schedule.rate)"/></dd><dt>Deal #</dt><dd t-esc="schedule.deal_number"/>
            </dl>
          </section>

          <section t-if="!state.drawerRow.attached and state.drawerRow.suggested">
            <h3>Possible Schedules</h3>
            <p class="mv-fuzzy__alt-hint">Ranked by rotation first. Rate mismatches are prominently flagged so a bad schedule rate cannot hide the correct rotation.</p>
            <div class="mv-postlog-sched mv-prelog-candidates">
              <table class="mv-postlog-sched__table">
                <thead><tr>
                  <th class="mv-postlog-sched__col-id">ID &amp; Status</th>
                  <th>Time &amp; Days</th>
                  <th>Length / Rate / Deal Number</th>
                  <th class="mv-postlog-sched__col-diff">Differences</th>
                  <th class="mv-postlog-sched__col-action">Action</th>
                </tr></thead>
                <tbody>
                  <t t-foreach="candidates()" t-as="c" t-key="c.schedule.id">
                    <tr class="mv-postlog-sched__row" t-att-class="c.suggested ? 'mv-postlog-sched__row--suggested' : ''">
                      <td class="mv-postlog-sched__col-id">
                        <div>
                          <span class="mv-postlog-sched__rank" t-att-class="c.suggested ? 'mv-postlog-sched__rank--first' : ''" t-esc="c_index + 1"/>
                          <a class="mv-postlog-sched__id" target="_blank" rel="noopener"
                             t-att-href="scheduleOpenUrl(c.schedule)" t-on-click.stop="() => {}" t-esc="c.schedule.name"/>
                        </div>
                        <div class="mv-postlog-sched__status" t-if="c.suggested">
                          <span class="mv-fuzzy__quality mv-fuzzy__quality--suggested">Suggested</span>
                        </div>
                      </td>
                      <td>
                        <div class="mv-postlog-sched__time" t-att-class="!c.exact_time_match ? 'mv-postlog-sched__diff' : ''"
                             t-esc="c.schedule.time_range or '—'"/>
                        <div class="mv-postlog-sched__days" t-att-class="c.day_mismatch ? 'mv-postlog-sched__diff' : ''"
                             t-esc="condenseDays(c.schedule.days_allowed)"/>
                      </td>
                      <td class="mv-postlog-sched__facts">
                        <div t-att-class="c.length_mismatch ? 'mv-postlog-sched__diff' : ''"><i class="fa fa-clock-o"/> <t t-esc="c.schedule.length or '—'"/></div>
                        <div t-att-class="c.rate_mismatch ? 'mv-postlog-sched__diff mv-prelog-candidates__rate-warning' : ''"><i class="fa fa-usd"/> <t t-esc="formatRate(c.schedule.rate)"/><span
                          class="mv-postlog-sched__delta" t-if="rateDelta(c.schedule)" t-esc="rateDelta(c.schedule)"/></div>
                        <div><i class="fa fa-file-text-o"/> Deal <t t-esc="c.schedule.deal_number"/></div>
                      </td>
                      <td class="mv-postlog-sched__col-diff">
                        <t t-set="diff" t-value="differenceSummary(c)"/>
                        <span class="mv-postlog-sched__match" t-att-class="diff.count ? 'mv-postlog-sched__match--warn' : 'mv-postlog-sched__match--ok'">
                          <i t-att-class="diff.count ? 'fa fa-exclamation-circle' : 'fa fa-check-circle'"/>
                          <span>
                            <span class="mv-postlog-sched__diff-count" t-esc="diff.label"/>
                            <t t-foreach="diff.parts" t-as="part" t-key="part_index">
                              <span class="mv-postlog-sched__diff-detail"
                                    t-att-class="diff.parts.length > 1 ? 'mv-postlog-sched__diff-detail--bulleted' : ''"
                                    t-esc="part"/>
                            </t>
                          </span>
                        </span>
                      </td>
                      <td class="mv-postlog-sched__col-action">
                        <button class="btn btn-sm mv-postlog-sched__btn" t-if="c.attachable"
                                t-att-class="c.suggested ? 'btn-success' : 'btn-outline-success'"
                                t-att-disabled="state.mutating"
                                t-on-click="() => c.suggested ? this.attachOneSuggestion(state.drawerRow) : this.attachAlternative(state.drawerRow, c.alternative)">Attach</button>
                        <span class="mv-postlog-sched__blocked" t-if="!c.attachable">Not sold</span>
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>
          </section>

          <section class="mv-fuzzy__overrun-panel"
                   t-if="state.drawerRow.is_overrun and state.drawerOverrun">
            <div class="mv-fuzzy__overrun-panel-head">
              <span class="mv-fuzzy__overrun-panel-title">Overruns</span>
              <span class="mv-fuzzy__overrun-panel-stat">
                Total Prelogs: <strong t-esc="state.drawerOverrun.total_prelogs"/>
              </span>
              <span class="mv-fuzzy__overrun-panel-stat">
                Capped Units: <strong t-esc="state.drawerOverrun.capped_units"/>
              </span>
            </div>
            <ul class="mv-fuzzy__overrun-list">
              <li t-foreach="state.drawerOverrun.prelogs" t-as="p" t-key="p.id">
                <span t-esc="p.name"/>
                <span class="mv-fuzzy__muted">
                  <t t-esc="p.air_date"/> <t t-esc="p.air_time"/>
                </span>
              </li>
              <li t-if="state.drawerOverrun.prelogs.length === 0"
                  class="mv-fuzzy__muted">No prelogs attached yet.</li>
            </ul>
            <div class="mv-fuzzy__overrun-panel-foot">
              <button type="button" class="mv-fuzzy__linklike"
                      t-on-click="() => this.viewAllOverrunPrelogs()">view all</button>
            </div>
          </section>

          <section><h3>Schedule actions</h3>
            <button class="btn btn-outline-warning w-100 mb-2" t-if="state.drawerRow.status === 'matched'"
                    t-on-click="() => this.detachSchedule(state.drawerRow)" t-att-disabled="state.mutating"><i class="fa fa-unlink me-1"/>Detach Schedule</button>
            <label class="mv-fuzzy__field"><span><t t-esc="state.drawerRow.status === 'matched' ? 'Replace with schedule' : 'Manual schedule'"/></span>
              <input type="text" placeholder="Schedule name or Odoo ID" t-att-value="state.manualSchedule" t-on-input="(ev) => this.state.manualSchedule = ev.target.value"/>
            </label>
            <button class="btn btn-outline-primary w-100 mt-2" t-on-click="() => this.attachManual(state.drawerRow)" t-att-disabled="state.mutating or !state.manualSchedule.trim()">
              <t t-esc="state.drawerRow.status === 'matched' ? 'Replace Schedule' : 'Attach Manual Schedule'"/>
            </button>
          </section>

          <section><h3>Record actions</h3>
            <a class="btn btn-outline-secondary w-100 mb-2" target="_blank" rel="noopener"
               t-att-href="prelogOpenUrl(state.drawerRow)"><i class="fa fa-external-link me-1"/>Open Full Prelog Record</a>
            <button class="btn btn-outline-danger w-100" t-if="state.drawerRow.status !== 'removed'" t-on-click="() => this.setRemoved(true, state.drawerRow)" t-att-disabled="state.mutating"><i class="fa fa-ban me-1"/>Remove Prelog Data</button>
            <button class="btn btn-outline-success w-100" t-if="state.drawerRow.status === 'removed'" t-on-click="() => this.setRemoved(false, state.drawerRow)" t-att-disabled="state.mutating"><i class="fa fa-undo me-1"/>Unremove Prelog Data</button>
            <button class="btn btn-danger w-100 mt-2" t-on-click="() => this.deleteSelected(state.drawerRow)" t-att-disabled="state.mutating"><i class="fa fa-trash me-1"/>Permanently Delete Prelog Data</button>
          </section>
        </div>
      </aside>

      <div class="mv-fuzzy__loading mv-fuzzy__loading--page" t-if="!state.loaded"><i class="fa fa-spinner fa-spin"/> Loading Prelog Operations Workbench…</div>
    </div>
  </t>
</templates>
